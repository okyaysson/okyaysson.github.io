<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Halisünasyon Coffee • Art</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    /* ─── CSS Variables ─── */
    :root {
      --font-display: 'Instrument Serif', serif;
      --font-body: 'Inter', sans-serif;
      --white: #ffffff;
      --black: #0a0a0a;
      --overlay-opacity: 0.38;
      --nav-gap: clamp(1.2rem, 3vw, 2.4rem);
    }

    /* ─── Reset & Base ─── */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: var(--font-body);
      -webkit-font-smoothing: antialiased;
      background: #0a0a0a;
    }

    /* ─── Video Background ─── */
    .video-wrap {
      position: fixed;
      inset: 0;
      z-index: 0;
    }

    .video-wrap video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* Overlay — siyah, %38 opaklık (10-20 arası isteniyordu ama okunurluk için biraz artırıldı; isterseniz 0.15'e çekilebilir) */
    .video-wrap::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, var(--overlay-opacity));
      pointer-events: none;
    }

    /* ─── Page Layout ─── */
    .page {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: clamp(1.4rem, 4vw, 2.8rem) clamp(1.4rem, 5vw, 3.2rem);
    }

    /* ─── Top bar: logo centered, nav left-pinned ─── */
    .top-bar {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 1rem;
    }

    /* ─── Logo (center column) ─── */
    .logo {
      text-align: center;
      opacity: 0;
      transform: translateY(-10px);
      animation: fadeSlideDown 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.15s forwards;
    }

    .logo-main {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(1.15rem, 3vw, 1.7rem);
      color: rgba(255, 255, 255, 0.96);
      letter-spacing: 0.03em;
      line-height: 1.1;
      display: block;
    }

    .logo-sub {
      font-family: var(--font-body);
      font-weight: 400;
      font-size: clamp(0.6rem, 1.3vw, 0.72rem);
      color: rgba(255, 255, 255, 0.55);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      display: block;
      margin-top: 0.25em;
    }

    /* ─── Navigation (left column) ─── */
    nav {
      display: flex;
      align-items: center;
      gap: var(--nav-gap);
      opacity: 0;
      transform: translateY(-10px);
      animation: fadeSlideDown 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s forwards;
    }

    nav a {
      font-family: var(--font-body);
      font-size: clamp(0.7rem, 1.5vw, 0.82rem);
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.82);
      text-decoration: none;
      position: relative;
      transition: color 0.3s ease;
    }

    nav a::after {
      content: '';
      position: absolute;
      bottom: -3px;
      left: 0;
      width: 0;
      height: 1px;
      background: rgba(255, 255, 255, 0.6);
      transition: width 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    nav a:hover {
      color: rgba(255, 255, 255, 1);
    }

    nav a:hover::after {
      width: 100%;
    }

    /* nav separator dots */
    nav a:not(:last-child)::before {
      content: none;
    }

    /* ─── Hero Content ─── */
    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
      gap: clamp(0.8rem, 2vw, 1.4rem);
      text-align: center;
      padding: 0 clamp(1rem, 6vw, 4rem);
      margin-top: -42vh; /* visually pull text toward upper half */
    }

    .hero-tagline {
      font-family: var(--font-body);
      font-weight: 400;
      font-size: clamp(1rem, 3.2vw, 1.55rem);
      color: rgba(255, 255, 255, 0.93);
      letter-spacing: 0.01em;
      line-height: 1.55;
      max-width: 680px;
      opacity: 0;
      transform: translateY(16px);
      animation: fadeSlideUp 1s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.55s forwards;
    }

    /* ─── Animations ─── */
    @keyframes fadeSlideDown {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeSlideUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ─── Responsive ─── */
    @media (max-width: 600px) {
      nav {
        gap: 1.1rem;
      }

      nav a {
        font-size: 0.67rem;
        letter-spacing: 0.09em;
      }

      .hero-tagline {
        font-size: clamp(0.98rem, 4.5vw, 1.15rem);
        padding: 0 0.5rem;
      }

      .logo-main {
        font-size: clamp(1rem, 5vw, 1.3rem);
      }
    }

    @media (max-width: 380px) {
      nav {
        gap: 0.85rem;
      }
    }
  </style>
</head>
<body>

  <!-- Background Video -->
  <div class="video-wrap">
    <video
      src="background.mp4"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      aria-hidden="true"
    ></video>
  </div>

  <!-- Page -->
  <div class="page">

    <!-- Top Bar: nav left, logo center -->
    <div class="top-bar">
      <nav aria-label="Ana navigasyon">
        <a
          href="https://halisunasyon.qr.menulux.com/?utm_source=ig&utm_medium=social&utm_content=link_in_bio&fbclid=PAZXh0bgNhZW0CMTEAc3J0YwZhcHBfaWQPOTM2NjE5NzQzMzkyNDU5AAGnJ5p_qN3_ETNyx4P93TuM0-a_3k4xXD07teg4qibvlf3IHc1E_xNMQfYw6-s_aem__bNeCTyMEQYHoy4Cjdt6ig#!/"
          target="_blank"
          rel="noopener noreferrer"
        >Menü</a>
        <a
          href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x14cab7155517837b:0xbae2d97b29569421?sa=X&ved=1t:8290&ictx=111"
          target="_blank"
          rel="noopener noreferrer"
        >Adres</a>
        <a
          href="https://www.instagram.com/halisunasyoncoffee/?hl=tr"
          target="_blank"
          rel="noopener noreferrer"
        >Instagram</a>
      </nav>

      <div class="logo">
        <span class="logo-main">Halisünasyon</span>
        <span class="logo-sub">Coffee &nbsp;•&nbsp; Art</span>
      </div>

      <!-- right spacer for grid balance -->
      <div aria-hidden="true"></div>
    </div>

    <!-- Hero -->
    <div class="hero">
      <p class="hero-tagline">Çiçekler arasında iyi kahve, iyi kokteyl, iyi yemek.</p>
    </div>

  </div>

</body>
</html>
